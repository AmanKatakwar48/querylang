digraph "Query_Execution_Plan" {
    rankdir=BT;
    node [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded", margin="0.2,0.1"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    p_0 [label="PROJECT\n[name, branch]", fillcolor="#E0EAFF", color="#3538CD", penwidth=2];
    p_1 [label="FILTER\nPredicate: BinaryOpNode(ColumnNode(age) >= LiteralNode(20, type=INTEGER))", fillcolor="#FEF0C7", color="#DC6803", penwidth=2];
    p_2 [label="SCAN\nTable: students", fillcolor="#D1FADF", color="#039855", penwidth=2];
    p_2 -> p_1;
    p_1 -> p_0;
}